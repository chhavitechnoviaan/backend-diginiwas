{
  "info": {
    "name": "DigiNiwas V1 Home APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "buyerToken",
      "value": ""
    },
    {
      "key": "buyerPassword",
      "value": ""
    },
    {
      "key": "lat",
      "value": "19.1197"
    },
    {
      "key": "lng",
      "value": "72.8464"
    },
    {
      "key": "city",
      "value": "Mumbai"
    },
    {
      "key": "propertyId",
      "value": "DW-1002"
    }
  ],
  "item": [
    {
      "name": "01 Buyer Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"9876543210\",\n  \"password\": \"{{buyerPassword}}\",\n  \"role\": \"buyer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auths/login-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auths",
            "login-password"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json.token) pm.collectionVariables.set(\"buyerToken\", json.token);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Home Feed",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/home/feed?lat={{lat}}&lng={{lng}}&city={{city}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "home",
            "feed"
          ],
          "query": [
            {
              "key": "lat",
              "value": "{{lat}}"
            },
            {
              "key": "lng",
              "value": "{{lng}}"
            },
            {
              "key": "city",
              "value": "{{city}}"
            }
          ]
        }
      }
    },
    {
      "name": "03 Dashboard Header",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{buyerToken}}",
            "type": "text"
          }
